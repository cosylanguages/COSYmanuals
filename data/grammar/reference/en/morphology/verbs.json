    {
      "id": "be_present_simple",
      "label": "Verb TO BE — Present Simple",
      "level": "starter",
      "definition": "Am, is, are · affirmative, negative & question",
      "emoji": "👤",
      "rules": [
        "I am",
        "You / We / They are",
        "He / She / It is"
      ],
      "examples": [
        {
          "t": "I am a student.",
          "m": "Example of first person singular"
        },
        {
          "t": "She is happy.",
          "m": "Example of third person singular"
        }
      ],
      "practice_links": [
        "manuals/en/grammar/a1/topics/to-be.html"
      ]
    },
    {
      "id": "present_simple",
      "label": "Present Simple",
      "level": "starter",
      "definition": "Routines, habits & facts",
      "emoji": "🕐",
      "rules": [
        "Use for habits, routines, and general truths.",
        "Add -s for He/She/It.",
        "Use don't/doesn't for negatives.",
        "Use Do/Does for questions."
      ],
      "examples": [
        {
          "t": "I work every day.",
          "m": "Habit"
        },
        {
          "t": "She works in Paris.",
          "m": "Third person -s"
        },
        {
          "t": "He doesn't like coffee.",
          "m": "Negative"
        }
      ],
      "practice_links": [
        "manuals/en/grammar/a1/topics/present-simple.html"
      ]
    },
    {
      "id": "past_simple",
      "label": "Past Simple",
      "level": "elementary",
      "definition": "Finished actions in the past · regular & irregular",
      "emoji": "🕰️",
      "rules": [
        "Use for finished actions in the past.",
        "Regular verbs add -ed.",
        "Irregular verbs have unique forms (e.g., go -> went)."
      ],
      "examples": [
        {
          "t": "Yesterday, I walked to the gym.",
          "m": "Regular verb"
        },
        {
          "t": "I went to London last year.",
          "m": "Irregular verb"
        }
      ],
      "practice_links": [
        "manuals/en/grammar/a1/topics/past-simple-regular.html",
        "manuals/en/grammar/a1/topics/past-simple-irregular.html"
      ]
    },
